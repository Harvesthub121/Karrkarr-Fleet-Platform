# =============================================================================
# Vida Partners Fleet API — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string (Prisma format)
DATABASE_URL="postgresql://vida:vida_dev_password@localhost:5432/vida_fleet?schema=public"

# --- App ---------------------------------------------------------------------
# HTTP port the NestJS app listens on
PORT=3000

# NODE_ENV: development | production | test
NODE_ENV=development

# Comma-separated list of allowed CORS origins (admin and customer frontends)
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# --- JWT ---------------------------------------------------------------------
# Secret for signing admin JWT access tokens (use a long random string in prod)
JWT_ADMIN_SECRET="change-me-admin-jwt-secret-min-32-chars"

# Secret for signing customer JWT access tokens (separate audience from admin)
JWT_CUSTOMER_SECRET="change-me-customer-jwt-secret-min-32-chars"

# Access token TTL (seconds). Default 900 = 15 minutes.
JWT_ACCESS_TTL_SECONDS=900

# Refresh token TTL (days). Default 30 days.
JWT_REFRESH_TTL_DAYS=30

# --- AWS S3 ------------------------------------------------------------------
# Region where the documents bucket lives
AWS_REGION="ap-southeast-1"

# S3 bucket name for all document uploads (never public)
S3_BUCKET="vida-fleet-documents"

# AWS credentials. In prod use IAM roles; these are for local/CI only.
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Override endpoint for local MinIO (leave blank in production)
S3_ENDPOINT="http://localhost:9000"

# Presigned URL TTL (seconds). Default 3600 = 1 hour.
S3_PRESIGN_TTL_SECONDS=3600

# --- Redis / BullMQ ----------------------------------------------------------
# Redis connection URL for BullMQ job queues
REDIS_URL="redis://localhost:6379"

# --- Logging -----------------------------------------------------------------
# Log level: error | warn | log | debug | verbose
LOG_LEVEL=log

# --- Email (Resend) -----------------------------------------------------------
# Create the key at resend.com and verify the sending domain BEFORE go-live,
# otherwise reminder emails silently land in spam.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Vida Partners <billing@vidapartners.com.sg>"
RESEND_REPLY_TO=support@vidapartners.com.sg

# --- Admin notification recipients --------------------------------------------
# Where "new payment submitted" and expiry alerts are emailed.
ADMIN_NOTIFICATION_EMAILS=ops@vidapartners.com.sg,accounts@vidapartners.com.sg

# --- Scheduling ---------------------------------------------------------------
# All jobs run on Singapore time. Do not change unless the business relocates.
APP_TIMEZONE=Asia/Singapore
# Set false on the web service and true on the worker service, so reminders are
# not fired once per web replica.
ENABLE_SCHEDULED_JOBS=true

# --- Frontend URLs (used in email deep links) ---------------------------------
PORTAL_BASE_URL=http://localhost:3001
ADMIN_BASE_URL=http://localhost:3002
