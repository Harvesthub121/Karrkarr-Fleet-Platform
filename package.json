{
  "name": "karrkarr-fleet",
  "version": "1.0.0",
  "private": true,
  "description": "Karrkarr Pte Ltd — Fleet Leasing Management Platform",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.11.0" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres redis",
    "db:migrate": "pnpm --filter @karrkarr/api prisma:migrate",
    "db:seed": "pnpm --filter @karrkarr/api prisma:seed",
    "db:studio": "pnpm --filter @karrkarr/api prisma:studio",
    "bootstrap": "pnpm install && pnpm db:up && sleep 5 && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.4",
      "@types/react-dom": "19.2.4"
    }
  }
}
