# =============================================================================
# Karrkarr Fleet Platform — Root .env.example
# Copy to .env and fill in values. Never commit .env.
#
# For apps/api specific variables, also see apps/api/.env.example
# =============================================================================

# --- Database ----------------------------------------------------------------
DATABASE_URL="postgresql://karrkarr:karrkarr_dev_password@localhost:5432/karrkarr_fleet?schema=public"

# --- App ---------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Comma-separated allowed CORS origins
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# --- JWT ---------------------------------------------------------------------
# Use long random strings in production: openssl rand -hex 64
JWT_ADMIN_SECRET="change-me-admin-jwt-secret-min-32-chars"
JWT_CUSTOMER_SECRET="change-me-customer-jwt-secret-min-32-chars"

# Access token TTL in seconds (default 900 = 15 minutes)
JWT_ACCESS_TTL_SECONDS=900

# Refresh token TTL in days (default 30)
JWT_REFRESH_TTL_DAYS=30

# --- AWS S3 ------------------------------------------------------------------
AWS_REGION="ap-southeast-1"
S3_BUCKET="karrkarr-fleet-documents"

# AWS credentials — use IAM roles in production (leave blank on ECS)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Local MinIO endpoint (leave blank in production)
S3_ENDPOINT="http://localhost:9000"

# Presigned URL TTL in seconds (default 3600 = 1 hour)
S3_PRESIGN_TTL_SECONDS=3600

# --- Redis / BullMQ ----------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Email (Resend) ----------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=""

# The verified sending domain / address configured in Resend
RESEND_FROM_ADDRESS="noreply@karrkarr.com.sg"

# --- Logging -----------------------------------------------------------------
# error | warn | log | debug | verbose
LOG_LEVEL=log

# --- Frontend (used by Next.js apps) -----------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3000"
